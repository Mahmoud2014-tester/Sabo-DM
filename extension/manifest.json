{
  "manifest_version": 3,
  "name": "Sabo DM — Download Integration",
  "version": "1.3.7",
  "description": "Sabo DM browser integration with recommended audio format selection and live download progress.",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:19345/*",
    "http://127.0.0.1:19346/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sabo DM",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
