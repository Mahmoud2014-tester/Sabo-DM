{
  "manifest_version": 3,
  "name": "Sabo DM Integration",
  "version": "1.27.0",
  "description": "Sabo DM browser integration with opt-in social-site cookies and feed media detection.",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sabo DM"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
